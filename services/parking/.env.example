# Argus parking service. Copy to .env (or inject via the environment).

DEBUG=false
DATABASE_URL=postgresql+asyncpg://parking:change_me@parking-db:5432/parking

# ── User authentication ──────────────────────────────────────────────────────
# Parking stores no users. Access tokens are issued by surveillance and
# verified against its JWKS over the internal mTLS channel (or a file).
AUTH_JWKS_URL=https://surveillance-host:8443/.well-known/jwks.json
# AUTH_JWKS_FILE=/run/secrets/argus/parking/jwks.json
# Dashboard session cookies: keep in step with surveillance's setting.
# AUTH_COOKIE_SECURE=true

# ── Service mesh ─────────────────────────────────────────────────────────────
SERVICE_NAME=parking
SERVICE_SIGNING_KEY_FILE=/run/secrets/argus/parking/service.key
SERVICE_PEER_KEYS_DIR=/run/secrets/argus/parking/peers
INTERNAL_TLS_CA_FILE=/run/secrets/argus/parking/ca.pem
INTERNAL_TLS_CERT_FILE=/run/secrets/argus/parking/tls.pem
INTERNAL_TLS_KEY_FILE=/run/secrets/argus/parking/tls.key
INTERNAL_REQUIRE_MTLS_HEADER=true
# Where parking delivers its events (gate passes, alerts). Unset = standalone.
SURVEILLANCE_INTERNAL_URL=https://surveillance-host:8443

# ── Vision ───────────────────────────────────────────────────────────────────
OPENVINO_MODEL_PATH=models/yolov8n.xml
OPENVINO_DEVICE=AUTO
# Camera networks the server may connect to (JSON list of CIDRs).
CAMERA_NETWORK_ALLOWLIST=[]
STREAM_HOST_ALLOWLIST=["mediamtx:8554"]
MEDIAMTX_ENABLED=true
MEDIAMTX_API_BASE_URL=http://mediamtx:9997
MEDIAMTX_API_USERNAME=mtx_api
MEDIAMTX_API_PASSWORD=change_me

# ── Parking ──────────────────────────────────────────────────────────────────
PARKING_OCCUPANCY_TEXTURE_FALLBACK=false
PARKING_VEHICLE_CLASSES=["car", "truck", "bus", "motorcycle"]
PARKING_AUTHORIZED_PROFILE_TYPES=["vip", "resident", "staff"]
PARKING_RATE_PER_HOUR=20.0
PARKING_OLLAMA_BASE_URL=http://ollama:11434
PARKING_OLLAMA_MODEL=qwen3:0.6b
