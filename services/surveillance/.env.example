# ─────────────────────────────────────────────────────────────────────────────
# Backend environment variables
# Copy this file to .env and fill in the values for your environment.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Async URL used by SQLAlchemy (FastAPI / asyncpg).
# Local dev default uses SQLite; set to Postgres for Docker / AWS RDS.
DATABASE_URL=sqlite+aiosqlite:///surveillance.db
# DATABASE_URL=postgresql+asyncpg://surveillance:surveillance@db:5432/surveillance

# When the primary (Postgres) database is unreachable at startup the backend
# now refuses to boot instead of silently falling back to SQLite (data written
# to the fallback is lost on container restart). Set to true only if you
# explicitly want the SQLite fallback behaviour.
ALLOW_DB_FALLBACK=false

# Sync URL used by Alembic migrations.
# DATABASE_URL_SYNC=postgresql+psycopg2://surveillance:surveillance@db:5432/surveillance

# ── Redis (optional) ─────────────────────────────────────────────────────────
# REDIS_URL=redis://redis:6379/0

# ── OpenVINO inference ────────────────────────────────────────────────────────
# Path to the OpenVINO IR model (.xml), relative to the backend/ directory.
OPENVINO_MODEL_PATH=models/yolov8n.xml

# Target device: CPU | GPU | NPU | AUTO
# On Intel Core Ultra laptops GPU (Arc iGPU) is fastest (~5 ms for YOLOv8n),
# NPU (~11 ms) leaves the GPU free for the browser, CPU is the fallback.
OPENVINO_DEVICE=AUTO

# LATENCY (default) | THROUGHPUT. Keep LATENCY: the detector makes blocking
# single-frame calls, and THROUGHPUT on an iGPU makes each call ~300x slower.
# OPENVINO_PERFORMANCE_HINT=LATENCY

# Model precision label (informational; actual precision is in the model file).
OPENVINO_PRECISION=FP16

# ── Camera source SSRF policy ─────────────────────────────────────────────────
# Stream hostnames are resolved and every address is checked. Cloud metadata
# addresses are always refused; loopback/link-local and private LAN addresses
# are refused unless their range is listed here (JSON list of CIDRs).
# On-prem example: CAMERA_NETWORK_ALLOWLIST=["192.168.10.0/24"]
CAMERA_NETWORK_ALLOWLIST=[]
# Internal media servers (host:port) allowed to resolve to container IPs.
STREAM_HOST_ALLOWLIST=["mediamtx:8554"]
# Plain http(s) camera sources (DroidCam / IP Webcam). Off by default.
ALLOW_HTTP_STREAMS=false
# Local capture devices ("0", "1") as camera sources.
ALLOW_LOCAL_CAPTURE_DEVICES=true
# Deprecated shortcut: RFC 1918 ranges + http. Prefer the settings above.
ALLOW_PRIVATE_STREAM_URLS=false
# Where video://<file> sources resolve (JSON list). Empty = ./video and ../../video
VIDEO_SOURCE_DIRS=[]

# ── Stream / batching ─────────────────────────────────────────────────────────
MAX_STREAMS=20
FRAME_SKIP=2
DETECTION_PERSIST_INTERVAL_SEC=1.0
BATCH_ENABLED=True
BATCH_MAX_SIZE=8
INFERENCE_WORKERS=2

# Experimental still-image appearance classifier; disabled by default.
CRIME_CLASSIFIER_ENABLED=false
# Only nudges the risk score unless standalone "verify footage" alerts are on.
CRIME_CLASSIFIER_STANDALONE_ALERTS=false
# Pin the model download (HF commit) and verify its SHA-256.
# CRIME_CLASSIFIER_MODEL_REVISION=
# CRIME_CLASSIFIER_MODEL_SHA256=



# ── Identity provider (access tokens) ────────────────────────────────────────
# Surveillance issues EdDSA (Ed25519) access tokens; peers verify them with
# the public JWKS at /.well-known/jwks.json. Generate keys with deploy/pki.sh.
# Required unless DEBUG=true (which uses an ephemeral key).
AUTH_SIGNING_KEY_FILE=/run/secrets/argus/surveillance/auth.key
# Public PEMs of retired signing keys still accepted during a rotation.
# AUTH_PREVIOUS_PUBLIC_KEYS_DIR=/run/secrets/argus/surveillance/previous-auth-keys

# Symmetric application secret (>= 32 chars) for local encryption uses.
# SECRET_KEY=change-me-in-production

# ── Service mesh (talking to the parking / face services) ────────────────────
SERVICE_NAME=surveillance
SERVICE_SIGNING_KEY_FILE=/run/secrets/argus/surveillance/service.key
SERVICE_PEER_KEYS_DIR=/run/secrets/argus/surveillance/peers
INTERNAL_TLS_CA_FILE=/run/secrets/argus/surveillance/ca.pem
INTERNAL_TLS_CERT_FILE=/run/secrets/argus/surveillance/tls.pem
INTERNAL_TLS_KEY_FILE=/run/secrets/argus/surveillance/tls.key
INTERNAL_REQUIRE_MTLS_HEADER=true
# Internal (mTLS) URL of the parking service; unset when parking is absent.
# PARKING_INTERNAL_URL=https://parking-host:8443

# Bearer tokens for API clients (/api/v1/auth/token), in minutes. Stateless
# JWTs cannot be revoked before they expire, so keep this short.
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# Dashboard sessions (httpOnly cookies): access token lifetime, idle timeout
# and absolute lifetime of a sign-in, in seconds.
# AUTH_SESSION_ACCESS_TTL_SECONDS=600
# AUTH_SESSION_IDLE_SECONDS=43200
# AUTH_SESSION_MAX_SECONDS=86400
# Only for DEBUG over plain http on a LAN address (browsers refuse Secure
# cookies there); must match parking's setting.
# AUTH_COOKIE_SECURE=true

# Block 4 (optional): also write per-frame ROI events to DB table `roi_events`.
ROI_EVENTS_WRITE_DB=false

# Max psycopg2 connections for the synchronous background writers.
# Raise if many cameras write ROI/intent telemetry concurrently.
# ROI_PG_POOL_MAX=16
# INTENT_PG_POOL_MAX=8

# MediaMTX control API used for dynamic path registration.
# Set MEDIAMTX_ENABLED=false for local runs without MediaMTX.
MEDIAMTX_ENABLED=true
MEDIAMTX_API_BASE_URL=http://mediamtx:9997
MEDIAMTX_REQUEST_TIMEOUT_SECONDS=3
MEDIAMTX_API_USERNAME=mtx_api
MEDIAMTX_API_PASSWORD=mtx_api_change_me
# Single ingest: analytics reads the MediaMTX path instead of opening a
# second RTSP session on the camera.
MEDIAMTX_SINGLE_INGEST=true
MEDIAMTX_RTSP_READ_BASE_URL=rtsp://mediamtx:8554

# Data retention worker (runs in backend lifespan).
RETENTION_ENABLED=true
RETENTION_DAYS=30
RETENTION_RUN_INTERVAL_SECONDS=86400
RETENTION_DELETE_RESOLVED_ALERTS_ONLY=true
RETENTION_DELETE_ROI_EVENTS=false
RETENTION_DELETE_ANALYTICS_SNAPSHOTS=false

# ── Contextual intrusion / risk engine (all optional, defaults shown) ─────────
# Zone anchor: "foot" (bottom-centre of bbox, recommended) or "center".
# ROI_ANCHOR=foot
# Keep a track's dwell timer alive across short detector dropouts.
# ROI_TRACK_GRACE_SEC=2.0
# One alert per zone incident; re-identified tracks re-use the same incident.
# ROI_INCIDENT_HOLDDOWN_SEC=30
# Risk score thresholds (0-100) → observe / suspicious / alert / critical.
# RISK_ENGINE_ENABLED=true
# RISK_LEVEL_SUSPICIOUS=25
# RISK_LEVEL_ALERT=50
# RISK_LEVEL_CRITICAL=75
# RISK_ALERT_COOLDOWN_SEC=20
# Quiet hours (whole hours, local time in RISK_QUIET_HOURS_TZ) add risk to any presence.
# RISK_QUIET_HOURS_START=22
# RISK_QUIET_HOURS_END=6
# RISK_QUIET_HOURS_TZ=UTC
# Two people within this ground distance for this long = "close contact".
# RISK_CLOSE_CONTACT_M=1.5
# RISK_CLOSE_CONTACT_SEC=2
# Person who got out of a car inherits that car's plate authorization for this long.
# RISK_VEHICLE_LINK_TTL_SEC=600
# Plate profile types that count as authorized (comma-separated JSON list).
# RISK_AUTHORIZED_PROFILE_TYPES=["vip","resident","staff"]
# Default length of a manual "mark known" grant from the live feed.
# RISK_MANUAL_GRANT_MINUTES=15
# Default horizontal FOV used for distance estimation until a camera is calibrated.
# CAMERA_DEFAULT_HFOV_DEG=84

# ── Misc ──────────────────────────────────────────────────────────────────────
DEBUG=false
PYTHONUNBUFFERED=1
