# Build context is the repository root for every service image; each
# Dockerfile copies only what it needs, and this keeps secrets, data and
# bulky artifacts out of the context entirely.

# VCS / IDE
.git
.github
.idea
.vscode
*.swp
.DS_Store

# Frontend has its own build context
frontend/

# Docs and plans
docs/
plans/
info_about_handover_to_other_ai_tools.md

# Python caches and environments
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
.venv
venv
env

# Secrets, local state, media and models (mounted at runtime)
**/.env
**/.env.*
!**/.env.example
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.pem
**/*.key
deploy/pki/out/
video/
services/*/video/
services/*/models/
services/*/data/
services/*/intrusion_monitor/roi_events.jsonl
