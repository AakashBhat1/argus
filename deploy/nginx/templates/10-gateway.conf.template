# Public gateway (surveillance host). The only listener the internet reaches.
# Environment:
#   PUBLIC_SERVER_NAME         e.g. argus.example.com
#   PUBLIC_TLS_CERT/KEY        Let's Encrypt (scripts/setup-tls.sh) or your CA
#   PARKING_EDGE               host:port of the parking host's internal
#                              listener, e.g. parking.lan:8443
#   PARKING_EDGE_NAME          TLS name on the parking certificate (parking)
#   SURVEILLANCE_UPSTREAM      default surveillance:8000
#   FRONTEND_UPSTREAM          default frontend:3001
#   MEDIAMTX_UPSTREAM          default mediamtx:8889

limit_req_zone $binary_remote_addr zone=argus_auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=argus_api:10m rate=30r/s;
limit_conn_zone $binary_remote_addr zone=argus_conn:10m;


upstream surveillance_api   { server ${SURVEILLANCE_UPSTREAM}; keepalive 16; }
upstream argus_frontend     { server ${FRONTEND_UPSTREAM}; keepalive 16; }
upstream surveillance_media { server ${MEDIAMTX_UPSTREAM}; }

server {
    listen 80;
    server_name ${PUBLIC_SERVER_NAME};

    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${PUBLIC_SERVER_NAME};

    ssl_certificate     ${PUBLIC_TLS_CERT};
    ssl_certificate_key ${PUBLIC_TLS_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:ArgusPublic:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 10m;
    limit_conn argus_conn 50;
    include /etc/nginx/snippets/security-headers.conf;

    # Internal APIs are never reachable from the public listener.
    location /internal/ { return 404; }

    location = /api/v1/auth/token {
        limit_req zone=argus_auth burst=5 nodelay;
        limit_req_status 429;
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_pass http://surveillance_api;
    }

    # Parking runs on its own host: forward over mutual TLS with the
    # gateway's client certificate, verifying the parking certificate.
    location /api/v1/parking/ {
        limit_req zone=argus_api burst=60 nodelay;
        limit_req_status 429;
        include /etc/nginx/snippets/proxy-headers.conf;
        include /etc/nginx/argus.d/05-gateway-to-parking.snippet;
        proxy_pass https://${PARKING_EDGE};
    }
    location /ws/parking {
        include /etc/nginx/snippets/proxy-headers.conf;
        include /etc/nginx/snippets/websocket.conf;
        include /etc/nginx/argus.d/05-gateway-to-parking.snippet;
        proxy_pass https://${PARKING_EDGE};
    }
    # Parking cameras' WebRTC playback: parking decides, over mTLS.
    location = /_auth/stream-parking {
        internal;
        include /etc/nginx/snippets/proxy-headers.conf;
        include /etc/nginx/argus.d/05-gateway-to-parking.snippet;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI /stream-parking/$argus_parking_stream;
        proxy_set_header X-Original-Method $request_method;
        proxy_pass https://${PARKING_EDGE}/api/v1/parking/streams/playback-auth;
    }
    location ~ "^/stream-parking/(?<argus_parking_stream>[A-Za-z0-9_-]{1,64}/whep(/[A-Za-z0-9_-]{1,128})?)$" {
        auth_request /_auth/stream-parking;
        include /etc/nginx/snippets/proxy-headers.conf;
        include /etc/nginx/argus.d/05-gateway-to-parking.snippet;
        proxy_set_header Cookie "";
        rewrite ^/stream-parking/(.*)$ /stream/$1 break;
        proxy_pass https://${PARKING_EDGE};
    }
    location /stream-parking/ { return 404; }

    location /api/ {
        limit_req zone=argus_api burst=60 nodelay;
        limit_req_status 429;
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_pass http://surveillance_api;
    }
    location /ws/ {
        include /etc/nginx/snippets/proxy-headers.conf;
        include /etc/nginx/snippets/websocket.conf;
        proxy_pass http://surveillance_api;
    }
    location = /.well-known/jwks.json {
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_pass http://surveillance_api;
    }
    # WebRTC (WHEP) playback of surveillance cameras. Only WHEP paths are
    # relayed, and only after surveillance confirms the signed-in user's
    # tenant owns the camera (the path checked is the normalised path
    # MediaMTX serves). MediaMTX sees the edge's viewer account, never the
    # browser's cookies.
    location = /_auth/stream {
        internal;
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI /stream/$argus_stream;
        proxy_set_header X-Original-Method $request_method;
        proxy_pass http://surveillance_api/api/v1/streams/playback-auth;
    }
    location ~ "^/stream/(?<argus_stream>[A-Za-z0-9_-]{1,64}/whep(/[A-Za-z0-9_-]{1,128})?)$" {
        auth_request /_auth/stream;
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_set_header Authorization "Basic ${MEDIAMTX_VIEWER_BASIC}";
        proxy_set_header Cookie "";
        rewrite ^/stream/(.*)$ /$1 break;
        proxy_pass http://surveillance_media;
    }
    location /stream/ { return 404; }
    location / {
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_pass http://argus_frontend;
    }
}
